rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true
        || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role
            == 'admin'
      );
    }

    function isShopOwner() {
      return isSignedIn() &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role
          == 'shopOwner';
    }

    function isSafeImage() {
      return request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|jpg|png|webp)');
    }

    match /product_images/{allPaths=**} {
      allow read: if true;
      allow write: if isSafeImage() && (isShopOwner() || isAdmin());
    }

    match /banner_images/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isSafeImage();
    }

    match /avatar_images/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && isSafeImage();
    }

    match /shop_logos/{allPaths=**} {
      allow read: if true;
      allow write: if isSafeImage() && (isShopOwner() || isAdmin());
    }

    match /shop_covers/{allPaths=**} {
      allow read: if true;
      allow write: if isSafeImage() && (isShopOwner() || isAdmin());
    }
  }
}
