rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.shopOwnerId == request.auth.uid;
      allow update, delete: if signedIn()
        && resource.data.shopOwnerId == request.auth.uid;
    }

    match /orders/{orderId} {
      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid || true);
      // Shop owners need to read marketplace orders; for MVP allow signed-in read.
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn();
      allow delete: if false;
    }
  }
}
