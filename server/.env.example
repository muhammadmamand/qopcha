PORT=8080
PUBLIC_URL=https://169-58-230-144.sslip.io
JWT_SECRET=change-this-to-a-long-random-string
ADMIN_EMAIL=admin@qopcha.com
ADMIN_PASSWORD=Admin123456
ADMIN_PHONE=07500000000
ALLOWED_ORIGIN=*

# PostgreSQL (Docker Compose sets DATABASE_URL automatically)
POSTGRES_USER=qopcha
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_DB=qopcha
# DATABASE_URL=postgres://qopcha:password@postgres:5432/qopcha

# Caddy HTTPS (optional override — default is sslip.io for this VPS IP)
# DOMAIN=api.yourdomain.com
# ACME_EMAIL=admin@qopcha.com

# Standing Tech WhatsApp / SMS gateway
STANDING_API_URL=https://gateway.standingtech.com/api/v4/sms/send
VERIFYWAY_API_URL=https://gateway.standingtech.com/api/v4/sms/send
VERIFYWAY_API_TOKEN=
VERIFYWAY_CHANNEL=whatsapp
VERIFYWAY_FALLBACK_CHANNEL=sms
VERIFYWAY_SENDER=QopchaApp
STANDING_SENDER_ID=QopchaApp
STANDING_LANG=en

# Firebase Cloud Messaging (system push when app is closed)
# Download service account JSON from Firebase Console → Project settings → Service accounts
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"qopchaapp",...}
# Or: GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/serviceAccount.json
FIREBASE_PROJECT_ID=qopchaapp
